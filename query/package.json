{
  "name": "@synthetism/query",
  "version": "1.0.0",
  "description": "The query language — what a service requires, as data, and the version its address is frozen at.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@synthetism/credential": "^1.0.0"
  },
  "devDependencies": {
    "@synthetism/did": "^1.0.0",
    "@synthetism/keys": "^1.0.0",
    "@synthetism/vc": "^1.0.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetism/packages.git"
  },
  "homepage": "https://synthetism.org",
  "author": {
    "name": "Synthetism",
    "email": "core@synthetism.ai",
    "url": "https://synthetism.org"
  },
  "keywords": [
    "synthetism",
    "verifiable-credentials",
    "requirements",
    "query-language"
  ],
  "engines": {
    "node": ">=24"
  }
}
