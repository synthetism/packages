{
  "name": "@synthetism/resolve",
  "version": "0.1.0",
  "description": "Which of a holder's credentials could satisfy each part of a requirement — candidates, not a choice. No third-party dependencies.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@synthetism/query": "^1.0.0"
  },
  "devDependencies": {
    "@synthetism/credential": "^1.0.0",
    "@synthetism/engine-ajv": "^0.1.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetism/packages.git"
  },
  "homepage": "https://synthetism.org",
  "author": {
    "name": "Synthetism",
    "email": "core@synthetism.ai",
    "url": "https://synthetism.org"
  },
  "keywords": [
    "synthetism",
    "verifiable-credentials",
    "requirements",
    "candidates"
  ],
  "engines": {
    "node": ">=24"
  }
}
